# Banco (Docker no desenvolvimento). Em produção, DATABASE_URL usa o pooler do Supabase e DIRECT_URL a conexão direta.
DATABASE_URL="postgresql://korte:korte@localhost:5433/korte"
DIRECT_URL="postgresql://korte:korte@localhost:5433/korte"

# Better Auth. Gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Brevo. Sem chave, os e-mails aparecem só no terminal (desenvolvimento).
BREVO_API_KEY=""
EMAIL_FROM="nao-responda@korte.app"

# Senha das contas de exemplo criadas pelo seed
SEED_PASSWORD=""

# Use "false" para não criar o histórico fictício de atendimentos
SEED_DEMO="true"
