sequenceDiagram
    autonumber
    actor Cliente
    participant UI as Tela (Server Action)
    participant UC as CreateAppointment
    participant Rep as AppointmentRepository
    participant Ev as EventPublisher
    participant Obs as SendConfirmationEmail

    Cliente->>UI: escolhe serviço, barbeiro e horário
    UI->>UI: valida sessão, perfil e dados
    UI->>UC: execute(command)
    UC->>Rep: findByBarberAndDay(barbeiro, data)
    Rep-->>UC: agenda, bloqueios e expediente
    UC->>UC: confere se o horário está livre
    UC->>Rep: save(appointment)
    alt horário ocupado no mesmo instante
        Rep-->>UC: conflito no banco
        UC-->>UI: horário indisponível
        UI-->>Cliente: "Esse horário acabou de ser ocupado"
    else gravado
        Rep-->>UC: ok
        UC->>Ev: publish(AppointmentCreated)
        Ev-)Obs: handle(evento)
        Obs-)Obs: envia o e-mail pelo Brevo
        UC-->>UI: agendamento criado
        UI-->>Cliente: tela de confirmação
    end
