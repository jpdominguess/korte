erDiagram
    user ||--o| barbershop : administra
    user ||--o| barber_profile : "atende como"
    barber_profile ||--o{ barber_service : realiza
    service ||--o{ barber_service : "é realizado por"
    barber_profile ||--o{ work_schedule : tem
    barber_profile ||--o{ schedule_block : tem
    barber_profile ||--o{ appointment : atende
    service ||--o{ appointment : "é agendado em"
    user |o--o{ appointment : "agenda (cliente)"

    barbershop {
        uuid id PK
        uuid owner_id FK
        text name
        text cep
        text street
        text number
        text city
        text phone
        text whatsapp
        text logo_url
    }
    user {
        uuid id PK
        text name
        text email UK
        text phone
        text role "OWNER, BARBER ou CLIENT"
        timestamptz created_at
    }
    barber_profile {
        uuid id PK
        uuid user_id FK, UK
        bool active
    }
    service {
        uuid id PK
        text name
        text description
        int duration_min
        numeric price
        bool active
    }
    barber_service {
        uuid barber_profile_id PK, FK
        uuid service_id PK, FK
    }
    work_schedule {
        uuid id PK
        uuid barber_profile_id FK
        int weekday
        time start_time
        time end_time
    }
    schedule_block {
        uuid id PK
        uuid barber_profile_id FK
        timestamptz starts_at
        timestamptz ends_at
        text reason
    }
    appointment {
        uuid id PK
        uuid barber_profile_id FK
        uuid service_id FK
        uuid client_id FK "nulo para avulso"
        text walk_in_name
        text walk_in_phone
        timestamptz starts_at
        timestamptz ends_at
        text status
    }
